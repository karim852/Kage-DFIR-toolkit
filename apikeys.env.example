# API keys — rename this file to "apikeys.env" and fill it in.
# Nothing is mandatory: every unconfigured step is simply skipped.
# Priority: config.json < apikeys.env < environment variables.

# --- Indicator enrichment ---
VT_API_KEY=
ABUSEIPDB_API_KEY=

# --- Automatic summary ---
# AI_PROVIDER: anthropic | openai | groq | mistral | openrouter | ollama | custom | none
# Each provider has its own endpoint, filled in automatically.
# Only set AI_BASE_URL for "custom", or to override.
#
#   anthropic   https://api.anthropic.com          claude-sonnet-4-6
#   openai      https://api.openai.com/v1          gpt-4o
#   groq        https://api.groq.com/openai/v1     llama-3.3-70b-versatile
#   mistral     https://api.mistral.ai/v1          mistral-large-latest
#   openrouter  https://openrouter.ai/api/v1       anthropic/claude-sonnet-4
#   ollama      http://localhost:11434/v1          llama3.1        (no key)
#
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=
